{
  "name": "detectodog-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/copy-public.mjs",
    "build:apk": "eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "check:native-deps": "node scripts/check-native-deps.mjs",
    "verify": "npm run typecheck && npm run check:native-deps && expo install --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.20",
    "expo-asset": "~11.1.7",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "eas-cli": "^16.17.4",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
